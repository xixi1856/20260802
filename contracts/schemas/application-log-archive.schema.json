{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["logId", "occurredAt", "level", "logger", "message", "service"],
  "properties": {
    "logId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "level": { "enum": ["WARN", "ERROR"] },
    "logger": { "type": "string", "maxLength": 200 },
    "message": { "type": "string", "maxLength": 2000 },
    "service": { "type": "string", "maxLength": 80 },
    "instance": { "type": ["string", "null"], "maxLength": 120 },
    "traceId": { "type": ["string", "null"], "maxLength": 64 }
  }
}
